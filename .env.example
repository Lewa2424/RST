# Runtime
APP_ENV=development
PORT=3000

# SQLite file. Do not put this on OneDrive/Google Drive/Dropbox while the app is running.
DATABASE_PATH=./data/rst.sqlite

# Uploads
MAX_UPLOAD_MB=25
IMPORT_TEMP_DIR=./tmp-imports

# OCR (server-side only). Leave empty to keep photo import optional — user can type numbers.
OCR_PROVIDER=gemini
OCR_MODEL=gemini-3.6-flash
OCR_API_KEY=

# Backups (SQLite backup API, not a live file copy)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Weight mismatch threshold in kg. Set to off to disable WEIGHT_MISMATCH.
WEIGHT_MISMATCH_THRESHOLD_KG=500

# CORS: comma-separated frontend origins. Use * only for local experiments.
CORS_ORIGIN=http://localhost:3000

# Frontend on Vercel talking to a remote API:
# VITE_API_BASE_URL=https://your-api-host.example

# Runtime
APP_ENV=development
PORT=3000

# --- Database ---
# Local default: SQLite file (kept for offline / rollback).
DATABASE_PATH=./data/rst.sqlite

# Neon / Postgres (when set, SQLite is NOT used):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# On Vercel set DATABASE_URL in Project → Settings → Environment Variables.

# Uploads
MAX_UPLOAD_MB=25
IMPORT_TEMP_DIR=./tmp-imports

# OCR (server-side only). Leave empty to keep photo import optional — user can type numbers.
OCR_PROVIDER=gemini
OCR_MODEL=gemini-3.6-flash
OCR_API_KEY=

# Backups (SQLite file backup API). For Neon use console snapshots instead.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Weight mismatch threshold in kg. Set to off to disable WEIGHT_MISMATCH.
WEIGHT_MISMATCH_THRESHOLD_KG=500

# CORS: comma-separated frontend origins. Use * only for local experiments.
# On Vercel + same-origin API you can leave * or your Vercel URL.
CORS_ORIGIN=http://localhost:3000
